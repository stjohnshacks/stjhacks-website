# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.
# None of these use the NEXT_PUBLIC_ prefix, so they stay on the server.

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...) or the legacy service_role key.
# It bypasses row-level security, so it must only ever be used on the server.
SUPABASE_SECRET_KEY=

# Resend: API Keys (a key with "Sending access" is enough)
RESEND_API_KEY=
# Must use a domain you've verified in Resend.
WAITLIST_FROM_EMAIL="St. John's Hacks <waitlist@your-domain.com>"
